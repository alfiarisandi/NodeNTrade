# --- MetaTrader 5 (akun DEMO) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Monex-Demo
# Opsional: path terminal64.exe jika MT5 tidak terdeteksi otomatis
MT5_PATH=

# --- Telegram ---
# Buat bot lewat @BotFather, ambil chat id lewat @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 9Router (otak AI / Claude) ---
# Tanpa /v1 di akhir: SDK Anthropic menambahkan /v1/messages sendiri
NINEROUTER_BASE_URL=http://localhost:20128
NINEROUTER_API_KEY=
# Nama model persis seperti di daftar model 9Router (GET /v1/models)
AI_MODEL=cc/claude-opus-4-7

# --- Auto-start (opsional, dipakai scripts\start_all.ps1) ---
# NINEROUTER_START_CMD=9router --tray --no-browser --skip-update --host 127.0.0.1
